DirectoryIndex index.html
RewriteEngine On

# AASA is an extensionless JSON resource and must remain at its canonical path.
RewriteRule ^\.well-known/apple-app-site-association$ - [END,T=application/json]

# Caddy handles public invitation previews with the original visitor IP.
RewriteRule ^api/ - [R=404,END]

# Keep internal files private when serving the source tree with Apache.
RewriteRule (^|/)\. - [R=404,END]
RewriteRule ^(nginx|tests|review-drafts|deploy)(/|$) - [R=404,END,NC]
RewriteRule (^|/)Dockerfile$ - [R=404,END,NC]
RewriteRule \.(conf|cjs|md|ya?ml|sql|bak|key|pem|p8)$ - [R=404,END,NC]

# Keep the invitation URL intact while serving the static landing page.
RewriteRule ^join/([A-Za-z0-9_-]{43})/?$ join/index.html [END]
RewriteRule ^join/?$ - [R=404,END]

# The English landing route shares its name with the directory of English subpages.
RewriteRule ^en/$ /en [R=301,END,NE]
RewriteRule ^en$ en.html [END]

# Redirect direct .html requests to clean URLs, including the home document.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,END,NE,NC]
RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,END,NE,NC]

# Resolve extensionless paths with or without a final slash to existing HTML files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]

<Files "apple-app-site-association">
    ForceType application/json
</Files>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-DCjzPZoj9mBtUUMHyV39rR3ungp99FPV2a3S3nQqirA=' 'sha256-jfPTNxJafJWWWalcmibBYgsASRmtW63kn56QXJ31X84=' 'sha256-tOrYg4g03BqRcNPRzfJc0u/M+bMoBsFzgKexOi5kHKM=' https://www.googletagmanager.com https://accounts.google.com/gsi/client https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://accounts.google.com; connect-src 'self' https://api.holasigue.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://accounts.google.com/gsi/ https://appleid.apple.com; frame-src https://accounts.google.com/gsi/ https://appleid.apple.com; form-action 'self' https://api.holasigue.com https://appleid.apple.com https://chatgpt.com/connector_platform_oauth_redirect https://chatgpt.com/connector/oauth/ mailto:; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
